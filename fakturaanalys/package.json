{
  "name": "fakturaanalys",
  "version": "1.0.0",
  "description": "Fakturaanalys för byggprojekt – körs helt på iPhone/iPad: tolkar fakturaunderlag med bilagor och gör analyser och jämförelser mellan projekt",
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/build.js --watch",
    "test": "node --no-warnings --test test/*.test.js",
    "ios:add": "npm run build && npx cap add ios",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "build:link": "node scripts/build.js --artifact",
    "build:local": "node scripts/build.js --local"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "capacitor-folder-access": "file:native/capacitor-folder-access",
    "sql.js": "^1.14.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^3.11.174"
  }
}
